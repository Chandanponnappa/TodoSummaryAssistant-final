spring.application.name=todo-summary-assistant

# Database Configuration
spring.datasource.url=jdbc:mysql://database-2.cxyewykm425v.ap-south-1.rds.amazonaws.com:3306/todo_db
spring.datasource.username=admin
spring.datasource.password=Chandan1234
